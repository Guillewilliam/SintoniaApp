rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Función central de seguridad
    function isVerifiedUser() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    match /users/{userId} {
      allow read, write: if isVerifiedUser() && request.auth.uid == userId;
    }

    match /invites/{inviteId} {
      // Cualquiera verificado puede intentar leer un código para aceptarlo
      allow read: if isVerifiedUser();
      // Solo verificados pueden crear
      allow create: if isVerifiedUser() && request.resource.data.creatorUid == request.auth.uid;
      allow update: if isVerifiedUser(); // Protegido atómicamente por transactions en frontend
    }

    match /connections/{connectionId} {
      allow read, update: if isVerifiedUser() && request.auth.uid in resource.data.participants;
      allow create: if isVerifiedUser() && request.auth.uid in request.resource.data.participants;
    }
    
    match /sessions/{sessionId} {
      allow read, write: if isVerifiedUser();
    }
  }
}